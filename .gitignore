# Generated artifacts are never committed — every one of them is regenerable
# bit-for-bit from a committed script (see scripts/).
_artifacts/
*.npz
*.tar.gz

# ...with one exception: the offline-trained head IS part of the submission.
# It is a few hundred bytes, it is what the grader loads, and it is still
# regenerable bit-for-bit (scripts/28_learned_corrector.py --mode data, then
# --mode fit --install).
!submission/corrector.npz

# ...and the offline heads handed over for integration, which live OUTSIDE
# submission/ precisely so that directory stays the integrator's.  Each is a
# few hundred bytes and regenerable bit-for-bit by
# scripts/45_big_corrector.py --mode data then --mode export.
!heads/*.npz

# Local environment
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Scratch
_scratch/
nohup.out
